# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Database ====================
# Supabase PostgreSQL is required by the backend.
# Copy the connection string from Supabase Dashboard → Connect.
# Prefer the Session Pooler connection for this long-running API process.
# Example only — never commit real credentials:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require
DATABASE_URL=
# Used only by the legacy SQLite→Supabase migration script; ignored by the backend.
DB_PATH=service/server/data/clawtrader.db

# ==================== API Keys ====================
ALPHA_VANTAGE_API_KEY=demo
# Finnhub free tier (60 calls/min) — fallback for technical analysis when yfinance is rate-limited
FINNHUB_API_KEY=d96p2j1r01qr77dld6qgd96p2j1r01qr77dld6r0
# Alpaca free tier (200 calls/min, data since 2016) — equity intraday history for backtesting
# Sign up at alpaca.markets (free paper trading account), get keys from dashboard sidebar.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: enrich US stock market-intel snapshots with Adanos social/news/prediction-market sentiment.
ADANOS_API_KEY=
# Schwab Trader API — OAuth 2.0 credentials from developer.schwab.com app registration.
# Run `python agents/schwab_oauth_flow.py` once to obtain the refresh token; it persists
# to ~/.config/devin/schwab_tokens.json. SCHWAB_REFRESH_TOKEN is optional as an env var
# (used as fallback if the persisted token file is absent).
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=

# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000

# ==================== Network / CORS ====================
CLAWTRADER_CORS_ORIGINS=http://localhost:3000,https://ai4trade.ai

# ==================== Market Data Endpoints ====================
ADANOS_API_BASE_URL=https://api.adanos.org
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Background Tasks ====================
POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800
ADANOS_SENTIMENT_CACHE_TTL_SECONDS=300
ADANOS_SENTIMENT_TIMEOUT_SECONDS=4

# ==================== Profit History Retention ====================
# Keep recent history at full resolution.
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24

# Keep compacted history inside this rolling window.
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7

# Bucket size used when compacting older profit history.
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15

# Minimum interval between prune/compact passes.
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Deterministic Runner Credentials ====================
# Required for the paper-only deterministic runners; do not commit real passwords.
BLITZ_RUNNER_PASSWORD=blitzrunner
CRYPTO_RUNNER_PASSWORD=cryptorunner
# StockBoy supervisor credentials and paper-only control limits.
# Never commit a real password; use a local secret in .env.
STOCKBOY_PASSWORD=
STOCKBOY_POLL_INTERVAL=60
STOCKBOY_MAX_ADJUSTMENT_NOTIONAL=50000
STOCKBOY_MAX_ACTIONS_PER_CYCLE=10
STOCKBOY_MAX_ACTIONS_PER_DAY=100
STOCKBOY_STALE_PRICE_AGE_SECONDS=300
STOCKBOY_STOP_TIGHTEN_ONLY=true

# ==================== Agent Trading Budget ====================
# Cap the effective capital agents use for position sizing, without changing
# their actual cash balance in the database. Agents will size trades as if
# they only have this much capital, leaving the rest as idle cash.
# Set to empty or remove to use full portfolio value.
AGENT_TRADE_BUDGET=10000

# ==================== Alpaca Paper Execution Layer ====================
# Per-agent Alpaca credentials are stored in alpaca_account_config. Do not place
# execution credentials in source-controlled environment files.
# Legacy global mirroring remains available only for compatibility endpoints.
ALPACA_MIRROR_TRADES=false
ALPACA_PAPER_TRADING_URL=https://paper-api.alpaca.markets/v2
ALPACA_WEBSOCKET_URL=wss://paper-api.alpaca.markets/stream
ALPACA_FILL_POLL_TIMEOUT=10
ALPACA_POSITION_CACHE_TTL=5
ALPACA_ACCOUNT_CACHE_TTL=5
ALPACA_BALANCE_SYNC_INTERVAL=30
ALPACA_RECONCILE_INTERVAL=60
ALPACA_RECONCILE_STARTUP_DELAY_SECONDS=60
ALPACA_RECONCILE_LOOKBACK_SECONDS=300
ALPACA_STREAM_RECONNECT_MAX_SECONDS=60

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60
